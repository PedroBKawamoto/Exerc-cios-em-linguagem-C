#include <stdbool.h>
/*
Em um sistema medico, cada paciente armazena nome, temperatura e saturacao. Considere a
struct abaixo e complete a funcao que indica se o paciente esta em risco*/
typedef struct {
char nome[30];
float temperatura;
float saturacao;
} Paciente;

/*
A funcao deve retornar true se a temperatura for maior ou igual a 39 ou se a saturacao for
menor que 92. Caso contrario, deve retornar false.*/
bool emRisco(Paciente p) {
    if(p.temperatura >= 39 || p.saturacao < 92){
        return true;
    }
    return false;
}

int main(){
    Paciente p1 = {"Pedro", 39, 80};
    if (emRisco(p1) == true){
        printf("paciente %s em situacao de risco\n", p1.nome);
    }
    else{
        printf("paciente %s fora de situacao de risco\n", p1.nome);
    }
}

