    int qfal[10];
    int elim = 0;
    for (int i = 0; i<10; i++){ 
        printf("digite a nota: ");
        scanf("%f", &notas[i]);

        printf("digite a quantidade de faltas: ");
        scanf("%d", &qfal[i]);


    }
    for (int i = 0; i <10; i++){
        nota_final[i] = notas[i] - qfal[i];
        
        if (nota_final[i] < 0){
            nota_final[i] = 0;
        }

        if (nota_final[i] < 6 || qfal[i] >3){
            elim++;
        }

    }
    for (int i =0; i<10; i++){
    printf("\na nota final do candidato %d e %f", i+1, nota_final[i]);}

    printf("\na quantidade de eliminados e %d", elim);
}




//6 - An ´alise da diagonal principal
int main(){
    int mat[4][4];
    int sdiag = 0;
    int q_aci = 0;
    for (int i =0; i<4; i++){
        for (int j = 0; j<4; j++){
            printf("digite um numero: ");
            scanf("%d", &mat[i][j]);
        }
    }
    for (int i =0; i<4; i++){
        for (int j = 0; j<4; j++){
            if (i == j){
                sdiag += mat[i][j];
                
            }
            else if(i<j){
                q_aci+=1;
            }
        }
    }
    printf("A soma da diagonal e %d", sdiag);
    printf("\nA quantidade de numeros acima da diagonal e %d", q_aci);
}




//7 - classifique a matriz

int main(){
    int mat[5][5];
    int mts = 0;
    int mti = 0;
    for (int i = 0; i < 5; i++){
        for(int j = 0; j < 5; j++){
        printf("digite um numero: ");
        scanf("%d", &mat[i][j]);
        }
    }
    for (int i = 0; i<5; i++){
        for (int j = 0; j < 5; j++){
            if (i < j){
                if (mat[i][j] == 0){
                    mts+=1;
                }
            }
            else if (i > j){
                if(mat[i][j] == 0){
                    mti+=1;
                }
            }
        }
    }
    if (mti == 10 && mts == 10){
    printf("matriz diagonal");
    }

    else if (mts == 10){
        printf("matriz triangular superior");
    
    }
    else if (mti == 10){
        printf("matriz triangular inferior");
    }

    else {
        printf("a matriz nao e triangular");
    }
}


